# include ./zathura

set selection-clipboard wl-clipboard
map <C-o> feedkeys ":exec okular $FILE"
map o feedkeys ":open"

# fond 

set default-bg "rgba(255, 192, 250,0.9)"
set default-fg "#000000"

# fond du pdf

set recolor-lightcolor "rgba(255,192,250,1)"
set recolor-darkcolor "#000000"

# resultat potentiels de la completion
set completion-bg "#d57bd5"
set completion-fg "#000000"

# seperateur utilise lors dune completion
set completion-group-bg "#C946BE"
set completion-group-fg "#000000"

# completion propose
set completion-highlight-bg "#fff1c9"
set completion-highlight-fg "#383838"

# barre en bas (de commande)
set inputbar-bg "#FFE07E"
set inputbar-fg "#000000"

# barre en bas (titre+page)
set statusbar-bg "#993590"
set statusbar-fg "#ffffff"

# texte surligne (trouve, selectionne a la souris..)
# set highlight-color

set recolor-keephue true
set recolor true

### OPTIONS ###
set link-hadjust true

set statusbar-page-percent true
set statusbar-home-tilde true
set window-title-basename true
set guioptions sh
set synctex true
set selection-clipboard clipboard
set scroll-page-aware true
set scroll-step 50

set render-loading true
set page-cache-size 15

set synctex true
set synctex-editor-command "hxtex +%{line} %{input}"
