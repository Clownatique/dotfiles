spawn-sh-at-startup "awww-daemon"
spawn-sh-at-startup "awww img .config/wallpapers/cable/clear.jpg"

animations {
    slowdown 0.75
}
prefer-no-csd
layout {
    gaps 10
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33333
    }
    default-column-width { proportion 0.5; }
    focus-ring{
        off
    }
    border {
        on
        active-color "#fff1c9"
        inactive-color "#604c0f"
        width 3
        urgent-color "#9b0000"
    }
    background-color "transparent"
    // focus-ring {
    //     width 2
    // }
    // struts {
    //     left 1
    //     right 1
    //     top 1
    //     bottom 1
    // }
}
