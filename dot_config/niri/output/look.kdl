spawn-sh-at-startup "awww-daemon"
spawn-sh-at-startup "awww img .config/wallpapers/cable/corridor.jpeg"

animations {
    slowdown 0.75
}
prefer-no-csd
layout {
    gaps 10
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33333
    }
    default-column-width { proportion 0.5; }
    focus-ring{
        off
    }
    shadow{
        draw-behind-window false
        off
    }
    border {
        on
        active-color "#fff1c9"
        inactive-color "#604c0f"
        width 3
        urgent-color "#9b0000"
    }
    // focus-ring {
    //     width 2
    // }
    // struts {
    //     left 1
    //     right 1
    //     top 1
    //     bottom 1
    // }
    background-color "#FFC0FA"
}
overview {
    zoom 0.6
    backdrop-color "#ffc0fa"

    workspace-shadow {
        // off
        softness 100
        spread 40
        offset x=0 y=10
        color "#993590"
    }
}
cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 25

    // hide-when-typing
    hide-after-inactive-ms 1000
}

