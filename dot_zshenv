PATH="$PATH:/home/nestor/.go/:/home/nestor/.local/share/gem/ruby/3.3.0/bin:/home/nestor/.opam/default/bin/:/home/nestor/.local/bin/"

HELIX_DEFAULT_RUNTIME=/usr/lib/helix/runtime

export GPG_TTY=$(tty)
export CHTSH_QUERY_OPTIONS="style=paraiso-light"

# export MANPATH="/usr/local/man:$MANPATH"
export LANG=en_US.UTF-8

PAGER=less
LESS_TERMCAP_mb=$'\E[01;31m'
LESS_TERMCAP_md=$'\E[01;31m'
LESS_TERMCAP_me=$'\E[0m'
LESS_TERMCAP_so=$'\E[01;44;33m'
LESS_TERMCAP_se=$'\E[0m'
LESS_TERMCAP_us=$'\E[01;32m'
LESS_TERMCAP_ue=$'\E[0m'
LESS="-FSRXI"

DISABLE_UNTRACKED_FILES_DIRTY="true"

# ZSH

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="bira"
plugins=(git)
HIST_STAMPS="dd/mm/yyyy"

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='hx'
fi
