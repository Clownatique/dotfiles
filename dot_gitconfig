[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[checkout]
	defaultRemote = origin


[core]
	editor = hx
	autocrlf = input
	excludesfile = ~/.gitignore_global

[merge]
	tool = helix

[mergetool "helix"]
	cmd = helix --vsplit "$LOCAL" "$REMOTE"

