#######
# ZSH #
#######


zstyle ':omz:update' mode auto      # update automatically without asking
zstyle ':omz:update' frequency 5

################
# SOURCE & ENV #
################

if [ -e /home/nestor/.cargo/env ]; then . "$HOME/.cargo/env" ; fi
[[ ! -r '/home/nestor/.opam/opam-init/init.zsh' ]] || source '/home/nestor/.opam/opam-init/init.zsh' > /dev/null 2> /dev/null
plugins=(git)
if [ -e /home/nestor/.nix-profile/etc/profile.d/nix.sh ]; then . /home/nestor/.nix-profile/etc/profile.d/nix.sh; fi 
if [ -e $ZSH/oh-my-zsh.sh ] ; then
  source $ZSH/oh-my-zsh.sh
else
  echo "Oh-My-ZSH not installed"
fi
[[ -f ~/.cache/color-sequences ]] && (cat ~/.cache/color-sequences &)
if [ -e /home/nestor/.cargo/env ]; then . "$HOME/.cargo/env" ; fi


#########
# ALIAS #
#########

alias ocaml="rlwrap ocaml"
alias proj="tmuxinator start"
alias untar="tar -xvf"
alias datemd="date --iso-8601=minutes"

################
# NIRI STARTUP #
################

# auto a niri session at logind
if [[ "$XDG_SESSION_TYPE" = "tty" ]]; then
  niri-session
fi

#############
# FUNCTIONS #
#############

dot() {
  chezmoi edit "$@" && chezmoi apply
}

